# ==============================================================================
# Tancoin (TAN) - cPanel Environment Variables Configuration (.env)
# ==============================================================================

# Set to False for production
DJANGO_DEBUG=False

# Generate a strong secret key for production (50+ random characters)
DJANGO_SECRET_KEY=tancoin-production-secret-replace-with-your-own-random-string-9912

# Comma-separated list of your domain names or subdomains
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,subdomain.yourdomain.com,127.0.0.1,localhost

# Comma-separated list of trusted HTTPS origins for CSRF validation
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://subdomain.yourdomain.com

# Optional external links for wallet top-up / cash-out buttons
WALLET_EXTERNAL_BUY_URL=
WALLET_EXTERNAL_CASHOUT_URL=
