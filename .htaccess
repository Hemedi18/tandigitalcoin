# ==============================================================================
# Tancoin (TAN) - cPanel Apache Configuration (.htaccess)
# ==============================================================================

# 1. Prevent Directory Indexing
Options -Indexes

# 2. Block direct web access to sensitive project files
<FilesMatch "^(db\.sqlite3|\.env.*|\.git.*|manage\.py|passenger_wsgi\.py|.*\.py|.*\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Allow static assets under /static/ and /staticfiles/
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional: Uncomment the following 2 lines if you want to force HTTPS:
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Serve staticfiles directly if the file exists on disk
    RewriteCond %{REQUEST_URI} ^/static/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/staticfiles/%1 -f
    RewriteRule ^static/(.*)$ staticfiles/$1 [L]
</IfModule>

# 4. Browser Caching for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
